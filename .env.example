# Official speech-to-speech deployment for this M3 Max Mac.
DEMO_PORT=7860
REALTIME_PORT=8765

# llama.cpp runs natively so it can use Metal.
# 8B is the low-latency default for realtime voice. M3 Max 128GB can switch
# this to Qwen/Qwen3-14B-GGUF:Q4_K_M for higher quality at higher latency.
LLM_HF_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M
LLM_ALIAS=girlfriend-main
LLM_CONTEXT=8192
LLM_API_KEY=请运行_scripts_setup-env.sh_生成

# Tutorial-equivalent Chinese STT, upgraded to the MLX Whisper build.
STT_MODEL=mlx-community/whisper-large-v3-turbo
STT_LANGUAGE=zh

# custom: immediately usable built-in voices and instant voice switching.
# clone: Qwen3-TTS Base + authorized reference audio under voices/.
TTS_MODE=custom
TTS_QUANTIZATION=6bit
TTS_SPEAKER=Serena
TTS_REFERENCE_AUDIO=voices/xiaoman/reference.wav
TTS_REFERENCE_TEXT=

# The demo container serves the official browser voice UI. WebSocket remains
# host-local; WebRTC is disabled in this Mac + Docker topology.
CHARACTER_FILE=./config/characters.custom.json
STARTUP_GREETING=请以角色身份自然地用一句中文向用户打招呼。
